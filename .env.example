# Copy to .env.local for development. Never commit real values.

# --- Database -------------------------------------------------------------
# Local development (Docker Compose, see docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/commerce_ops"
DIRECT_URL="postgresql://postgres:postgres@localhost:55432/commerce_ops?connection_limit=1"
#
# Production (Supabase, ap-northeast-1). DATABASE_URL is the transaction pooler
# (port 6543); DIRECT_URL is the session-mode pooler (port 5432). Migrations
# cannot run through the transaction pooler, and the session pooler — not the
# db.<ref>.supabase.co direct host — is what IPv4-only CI runners can reach.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Error monitoring -----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
# Optional. Source maps upload only when all three are set; builds without them succeed.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# --- Background jobs ------------------------------------------------------
# Optional locally (run `pnpm dlx inngest-cli@latest dev`, which needs neither),
# but REQUIRED in production: Inngest runs in cloud mode there and /api/inngest
# returns 500 without them. The env schema enforces this.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
